# LLM provider keys
UNIFIED_ENDPOINT_BASE_URL_ANTHROPIC=
UNIFIED_ENDPOINT_KEY=

# Currently "claude" is the only supported provider.
# The LLMClient interface (app/llm/base.py) allows additional providers to be added
# without changing any caller code — inject a new implementation via dependency injection.
DEFAULT_LLM_PROVIDER=claude

# Embedding model
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Vector store backend: "local" or "bigquery"
VECTOR_STORE=local
CHROMA_PERSIST_DIR=./chroma_db

# GCP (only used in production / bigquery mode => Which is currently only a stub, no actual implementation)
GCP_PROJECT_ID=
BIGQUERY_DATASET=payback_assistant
