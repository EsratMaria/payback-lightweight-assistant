# LLM provider keys
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Which LLM to use as default: "claude" or "gemini"
DEFAULT_LLM_PROVIDER=claude

# Embedding model
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Vector store backend: "local" or "bigquery"
VECTOR_STORE=local
CHROMA_PERSIST_DIR=./chroma_db

# GCP (only used in production / bigquery mode)
GCP_PROJECT_ID=
BIGQUERY_DATASET=payback_assistant
